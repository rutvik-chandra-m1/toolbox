{
  "name": "toolbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal toolbox: many small offline tools in one app (web/PWA + Android).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "android:check": "node scripts/build-apk.mjs --check",
    "android:sync": "vite build --mode native && cap sync android",
    "android:build": "node scripts/build-apk.mjs",
    "android:open": "cap open android",
    "sample:docx": "node scripts/make-sample-docx.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "dexie": "^4.4.6",
    "docx-preview": "^0.4.1",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.9.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
